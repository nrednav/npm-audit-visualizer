{
  "name": "npm-audit-visualizer",
  "version": "1.0.0-alpha.10",
  "description": "a web-based tool to visualize audit reports generated by npm audit",
  "type": "module",
  "author": "Vandern Rodrigues <nrednav@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "26.13.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nrednav/npm-audit-visualizer.git"
  },
  "homepage": "https://github.com/nrednav/npm-audit-visualizer#readme",
  "bugs": {
    "url": "https://github.com/nrednav/npm-audit-visualizer/issues"
  },
  "keywords": [
    "npm",
    "audit",
    "report",
    "visualizer",
    "json",
    "security",
    "vulnerability",
    "severity",
    "dependency",
    "graph",
    "table",
    "summary",
    "tool"
  ],
  "bin": {
    "npm-audit-visualizer": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ./scripts/copy-surface.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/main.js"
  },
  "devDependencies": {
    "@npm-audit-visualizer/contract": "1.0.0-alpha.10",
    "@types/node": "26.6.10",
    "tsup": "9.0.0",
    "tsx": "4.23.15"
  }
}
